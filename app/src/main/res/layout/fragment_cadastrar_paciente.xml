<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F3F7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cadastrar paciente"
            android:textColor="#24344A"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preencha os dados do novo paciente."
            android:textColor="#778397"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"/>

        <!-- INFORMAÇÕES PESSOAIS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Informações pessoais"
            android:textColor="#24344A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtNomePaciente"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Nome completo"
            android:inputType="textPersonName"
            android:padding="12dp"
            android:backgroundTint="#2876C7"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtDataNascimento"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Data de nascimento"
            android:inputType="date"
            android:padding="12dp"
            android:backgroundTint="#2876C7"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtCpf"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="CPF"
            android:inputType="number"
            android:padding="12dp"
            android:backgroundTint="#2876C7"
            android:layout_marginBottom="24dp"/>

        <!-- CONTATO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contato"
            android:textColor="#24344A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtTelefone"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Telefone do paciente"
            android:inputType="phone"
            android:padding="12dp"
            android:backgroundTint="#2876C7"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtResponsavel"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Nome do responsável"
            android:inputType="textPersonName"
            android:padding="12dp"
            android:backgroundTint="#2876C7"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtTelefoneResponsavel"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Telefone do responsável"
            android:inputType="phone"
            android:padding="12dp"
            android:backgroundTint="#2876C7"
            android:layout_marginBottom="24dp"/>

        <!-- INFORMAÇÕES ADICIONAIS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Informações adicionais"
            android:textColor="#24344A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtEndereco"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Endereço completo"
            android:inputType="textPostalAddress"
            android:padding="12dp"
            android:backgroundTint="#2876C7"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtObservacoes"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:hint="Observações médicas"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:backgroundTint="#2876C7"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnCadastrarPaciente"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Cadastrar paciente"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:backgroundTint="#2876C7"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</ScrollView>
