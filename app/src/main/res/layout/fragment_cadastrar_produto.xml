<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F1F3F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cadastrar produto"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#24344A" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preencha as informações do novo produto."
            android:textSize="15sp"
            android:textColor="#687586"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="25dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome do produto"
            android:textColor="#24344A"
            android:textStyle="bold"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etNomeProduto"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Digite o nome do produto"
            android:padding="14dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:inputType="textCapSentences" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tipo do produto"
            android:textColor="#24344A"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginTop="20dp" />

        <EditText
            android:id="@+id/etTipoProduto"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Digite o tipo do produto"
            android:padding="14dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:inputType="textCapSentences" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Código QR"
            android:textColor="#24344A"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginTop="20dp" />

        <EditText
            android:id="@+id/etCodigoQR"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Digite o código QR"
            android:padding="14dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unidade de medida"
            android:textColor="#24344A"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginTop="20dp" />

        <EditText
            android:id="@+id/etUnidadeMedida"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Ex.: unidade, pacote, litro"
            android:padding="14dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:inputType="textCapSentences" />

        <Button
            android:id="@+id/btnSalvarProduto"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="32dp"
            android:text="Salvar produto"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2876C7" />

    </LinearLayout>

</ScrollView>
