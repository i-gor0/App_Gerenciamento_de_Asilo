<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F1F3F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estoque geral"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#24344A" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Consulte os produtos disponíveis na instituição."
            android:textSize="15sp"
            android:textColor="#687586"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etBuscarProduto"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="24dp"
            android:hint="Pesquisar produto"
            android:padding="14dp"
            android:background="@android:drawable/edit_text"
            android:singleLine="true"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Produtos cadastrados"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#24344A"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/containerProdutosEstoque"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEstoqueVazio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nenhum produto cadastrado."
                android:textSize="15sp"
                android:textColor="#687586"
                android:gravity="center"
                android:padding="30dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnEscanearQR"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:text="Escanear QR Code"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2876C7" />

        <Button
            android:id="@+id/btnCadastrarProduto"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:text="Cadastrar produto"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2876C7" />

        <Button
            android:id="@+id/btnAbastecerEstoque"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:text="Abastecer estoque"
            android:textColor="#FFFFFF"
            android:backgroundTint="#24344A" />

    </LinearLayout>

</ScrollView>
