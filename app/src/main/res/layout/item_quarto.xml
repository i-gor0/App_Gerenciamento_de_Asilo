<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:layout_marginBottom="12dp"
    android:background="#FFFFFF"
    android:elevation="2dp">

    <TextView
        android:id="@+id/tvNumeroQuarto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Número do quarto"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="#24344A" />

    <TextView
        android:id="@+id/tvCapacidadeQuarto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Capacidade: "
        android:textSize="15sp"
        android:textColor="#687586"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="15dp">

        <Button
            android:id="@+id/btnEditarQuarto"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:text="Editar"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2876C7" />

        <Button
            android:id="@+id/btnExcluirQuarto"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Excluir"
            android:textColor="#FFFFFF"
            android:backgroundTint="#C74747" />

    </LinearLayout>

</LinearLayout>
